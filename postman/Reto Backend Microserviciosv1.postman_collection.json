        {
          "name": "Consultar Historial de Pedido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial: NONE->PENDING->CONFIRMED', function () {",
                  "  pm.response.to.have.status(200);",
                  "  var h = pm.response.json();",
                  "  pm.expect(h).to.have.lengthOf(2);",
                  "  pm.expect(h[0].previousStatus).to.eql('NONE');",
                  "  pm.expect(h[0].newStatus).to.eql('PENDING');",
                  "  pm.expect(h[1].previousStatus).to.eql('PENDING');",
                  "  pm.expect(h[1].newStatus).to.eql('CONFIRMED');",
                  "});"
                ]
              }
            }
